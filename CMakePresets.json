{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    { "name": "default", "displayName": "Default build", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build-default", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON", "CMAKE_CXX_COMPILER": "clang++" } },
    { "name": "debug-sanitizers", "displayName": "Debug with sanitizers", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build-sanitize", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON", "CMAKE_CXX_COMPILER": "clang++", "PTXSCOPE_ENABLE_SANITIZERS": "ON" } }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "debug-sanitizers", "configurePreset": "debug-sanitizers" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true } },
    { "name": "debug-sanitizers", "configurePreset": "debug-sanitizers", "output": { "outputOnFailure": true } }
  ]
}

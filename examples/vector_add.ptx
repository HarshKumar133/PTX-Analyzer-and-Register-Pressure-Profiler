.version 7.0
.target sm_70
.address_size 64

.visible .entry vector_add(
    .param .u64 vector_add_a,
    .param .u64 vector_add_b,
    .param .u64 vector_add_out
) {
    .reg .pred %p<2>;
    .reg .b32 %r<5>;
    .reg .b64 %rd<4>;

    mov.u32 %r0, %tid.x;
    setp.lt.u32 %p0, %r0, 128;
    @!%p0 bra DONE;
    mul.wide.u32 %rd0, %r0, 4;
    ld.global.u64 %rd1, [vector_add_a];
    ld.global.u64 %rd2, [vector_add_b];
    add.u64 %rd1, %rd1, %rd0;
    add.u64 %rd2, %rd2, %rd0;
    ld.global.u32 %r1, [%rd1];
    ld.global.u32 %r2, [%rd2];
    add.u32 %r3, %r1, %r2;
    ld.global.u64 %rd3, [vector_add_out];
    add.u64 %rd3, %rd3, %rd0;
    st.global.u32 [%rd3], %r3;
DONE:
    ret;
}
